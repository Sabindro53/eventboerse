# Eventbörse.de - Apache Configuration for IONOS
# Security-Hardening + Caching. Header werden zusätzlich PHP-seitig in
# functions.php gesetzt (redundant, falls mod_headers nicht greift).

# Force HTTPS (auch hinter Reverse-Proxy via X-Forwarded-Proto)
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Kompression. Brotli ZUERST: wo es da ist, gewinnt es gegen gzip um rund
# 15–20 % auf Text — bei app.js sind das ~35 KB je Erstbesuch. Der Browser
# wählt über Accept-Encoding, es gibt also keine falsche Antwort.
#
# Beide Blöcke stehen bewusst nebeneinander: <IfModule> ist keine Fallunter-
# scheidung zur Laufzeit, sondern beim Start. Fehlt mod_brotli auf dem
# IONOS-Pool, greift der deflate-Block unverändert weiter — deshalb darf er
# NICHT durch Brotli ersetzt werden.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Antworten unterscheiden sich je nach Accept-Encoding. Ohne diesen Kopf
# darf ein Zwischenspeicher eine brotli-komprimierte Antwort an einen
# Browser ausliefern, der nur gzip kann — dann ist die Seite kaputt, und
# zwar nur für manche.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json|svg)$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# ── WebP ausliefern, ohne eine gespeicherte Adresse anzufassen ──
#
# Gemessen am 31.08.2026 gegen die Live-Seite: 1285 KB der 2189 KB einer
# Startseite sind Bilder, und Lighthouse beziffert allein den FORMAT-Gewinn
# auf 675 KB. Nicht die Dimension — `uses-responsive-images` meldet 0 Bytes;
# die Bilder werden ungefähr so ausgeliefert, wie sie angezeigt werden. Ein
# srcset brächte hier nichts.
#
# eb_listings.images hält blanke URLs als JSON. Diese umzuschreiben wäre ein
# Durchlauf über echte Nutzerdaten. Stattdessen liegt `foo.jpg.webp` NEBEN
# `foo.jpg`, und der Server entscheidet pro Anfrage.
#
# Ausfallsicher in jede Richtung: fehlt die .webp-Datei (-f schlägt fehl),
# fehlt mod_rewrite, oder schickt der Browser kein `Accept: image/webp`,
# kommt unverändert das Original. Es gibt keinen Zustand, in dem ein Bild
# fehlt — deshalb ist das hier vertretbar und ein Umschreiben der Datenbank
# nicht.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_ACCEPT} image/webp
  RewriteCond %{REQUEST_FILENAME} \.(jpe?g|png)$ [NC]
  RewriteCond %{REQUEST_FILENAME}\.webp -f
  RewriteRule ^(.+)$ $1.webp [T=image/webp,E=EB_WEBP:1,L]
</IfModule>

# Vary: Accept ist hier PFLICHT, nicht Kür. Ohne diesen Kopf darf ein
# Zwischenspeicher — Browser-Cache, Proxy, CDN — die WebP-Antwort an einen
# Client weitergeben, der kein WebP annimmt. Der bekäme dann unter einer
# .jpg-Adresse Bytes, die er nicht dekodieren kann: ein kaputtes Bild, und
# zwar nur für manche. Dieselbe Mechanik wie bei Accept-Encoding oben.
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png)$">
    Header append Vary Accept
  </FilesMatch>
  # Der ausgelieferte Inhalt ist WebP, auch wenn die Adresse auf .jpg endet.
  Header set Content-Type "image/webp" env=EB_WEBP
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Cache-Control für versionierte Assets (Querystring-busted) → immutable
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Keep-Alive (mehr Requests pro Connection → schneller)
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>

# Disable caching for REST API (dynamic JSON data)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/wp-json/#">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </If>
</IfModule>

# Security Headers (OWASP-konform; Volltext-CSP wird aus PHP gesetzt)
<IfModule mod_headers.c>
  # HSTS – 2 Jahre, inkl. Subdomains. Nur wenn HTTPS aktiv ist.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  # X-XSS-Protection deaktiviert (legacy, in modernen Browsern durch CSP ersetzt)
  Header always set X-XSS-Protection "0"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-site"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
  # Server-Banner reduzieren
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>
ServerSignature Off

# Sensible Dateien blockieren
<FilesMatch "(^\.|\.(env|git|gitignore|gitattributes|md|markdown|log|sql|yml|yaml|lock|ini|conf|bak|swp|orig|dist)|wp-config\.php|xmlrpc\.php|readme\.html|license\.txt|liesmich\.html)$">
  Require all denied
</FilesMatch>

# ===========================================================
# Upload-Verzeichnisse: KEINE Skript-Ausführung erlauben.
# Blockiert PHP/CGI/Perl etc. selbst falls eine bösartige Datei
# dort landet (Defense-in-Depth gegen polyglot-Uploads, RFI/LFI).
# ===========================================================
<IfModule mod_rewrite.c>
  RewriteRule ^wp-content/uploads/.*\.(php|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|exe|bat|cmd|svg|html?|js)$ - [F,L,NC]
  RewriteRule ^uploads/.*\.(php|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|exe|bat|cmd|svg|html?|js)$ - [F,L,NC]
</IfModule>

# Vault- und CI-Verzeichnisse abschotten
RedirectMatch 404 /\.git
RedirectMatch 404 ^/(vault|\.github)(/|$)

# HQ nur über /hq — und damit nur durch die PHP-Rechteprüfung.
# Die Theme-Datei selbst wird von Apache direkt ausgeliefert, PHP läuft dabei
# nie. Ohne diese Sperre wäre die Rechteprüfung in functions.php umgehbar,
# indem man den Theme-Pfad direkt aufruft.
RedirectMatch 404 ^/wp-content/themes/[^/]+/hq\.html$

# Interne Rechtskataloge duerfen ebenfalls nur ueber die kurze /assets-Route
# laufen; dort prueft WordPress den HQ-Zugang inklusive zweitem Faktor. Der
# direkte Theme-Pfad wuerde PHP und damit diese Rechtepruefung umgehen.
RedirectMatch 404 ^/wp-content/themes/[^/]+/assets/eb-rechts(unterlagen|unterlagen-katalog|quellen)\.json$

# RedirectMatch wird von manchen IONOS-Apache-Konfigurationen in einer
# Theme-.htaccess nicht auf statische Unterordner angewandt. Die per-directory
# RewriteRule trifft den tatsaechlichen Pfad relativ zu diesem Theme. Der
# FilesMatch ist das zweite Netz, falls mod_rewrite dort deaktiviert ist.
<IfModule mod_rewrite.c>
  RewriteRule ^assets/eb-rechts(unterlagen|unterlagen-katalog|quellen)\.json$ - [R=404,L,NC]
</IfModule>
<FilesMatch "^eb-rechts(unterlagen|unterlagen-katalog|quellen)\.json$">
  Require all denied
</FilesMatch>

# Verzeichnis-Listing aus
Options -Indexes
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# Default document
DirectoryIndex index.php index.html

# Custom Error Page
ErrorDocument 404 /index.html

# ── Upload-Limit: 15 MB pro Bild ────────────────────────────────────────
# Reicht PHP nicht so viel durch, bricht der Upload ab, bevor functions.php
# ihn sieht — $_FILES ist dann leer und der Nutzer bekommt nur "Upload-Fehler".
# post_max_size etwas größer als upload_max_filesize, weil neben der Datei
# noch Formularfelder mitkommen.
# ACHTUNG: Diese Datei wird ins Theme-Verzeichnis deployt
# (/public/wp-content/themes/eventboerse/). Bei mod_php greift der Block dort
# noch; unter FastCGI/PHP-FPM — dem IONOS-Standard — wird er ignoriert. Dann
# muss das Limit im IONOS-PHP-Panel oder in /public/.user.ini stehen:
#   upload_max_filesize = 16M
#   post_max_size = 20M
# Ist es zu klein, antwortet eb_handle_upload() mit 413 und nennt den Wert.
<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 20M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 20M
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 20M
</IfModule>

{
  "name": "eventboerse",
  "version": "1.0.0",
  "description": "Eventbörse.de ist eine moderne Event-Marktplatz-Plattform, die Veranstalter und Event-Dienstleister zusammenbringt. Nutzer können Events erstellen, Services entdecken, Preise verhandeln und direkt über die Plattform zusammenarbeiten.",
  "main": "app.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "assets:ios-logo": "node scripts/generate-ios-brand-assets.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test tests/e2e/smoke.spec.js",
    "test:suche": "playwright test tests/e2e/suche.spec.js",
    "test:gebuehren": "playwright test tests/e2e/gebuehren.spec.js",
    "test:wissen": "playwright test tests/e2e/wissensbasis.spec.js",
    "test:css": "playwright test tests/e2e/css-minify.spec.js",
    "test:zufluss": "playwright test tests/e2e/zufluss.spec.js",
    "test:a11y": "playwright test tests/e2e/barrierefreiheit.spec.js",
    "gate": "node scripts/build-knowledge.mjs --check && node scripts/quarantine.mjs --check && node scripts/demo-feed.mjs --check && node scripts/connectors.mjs --check && node scripts/models.mjs --check && node scripts/openrouter-agents.mjs --self-test && node scripts/agent.mjs --check && ./build-app-js.sh --check",
    "test:agents": "node scripts/openrouter-agents.mjs --self-test",
    "test:verbindungen": "playwright test tests/e2e/verbindungen.spec.js",
    "test:kern": "playwright test tests/e2e/kern.spec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sabindro53/eventboerse.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Sabindro53/eventboerse/issues"
  },
  "homepage": "https://github.com/Sabindro53/eventboerse#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "8.5.1",
    "@playwright/test": "^1.62.1",
    "csso-cli": "^4.0.2"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  }
}
